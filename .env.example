DATABASE_URL=postgresql+psycopg://pace:pace@localhost:5432/pace

# Real values belong in .env, which is gitignored. This file is the committed
# template — never put a live secret here.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/api/auth/strava/callback
STRAVA_WEBHOOK_VERIFY_TOKEN=

# --- Coach LLM -----------------------------------------------------------
# Provider-agnostic: any OpenAI-compatible chat-completions endpoint works.
# The coach never computes numbers, so a free-tier model is adequate — see
# backend/app/coach/README.md for the reasoning and provider trade-offs.
#
# Groq (default: no card, 30 RPM / 1000 RPD, fast streaming)
COACH_BASE_URL=https://api.groq.com/openai/v1
COACH_MODEL=openai/gpt-oss-120b
COACH_API_KEY=

# Alternatives — swap the three values above:
#   Google Gemini   https://generativelanguage.googleapis.com/v1beta/openai
#                   gemini-2.5-flash            (1500 RPD; trains on prompts)
#   Cloudflare      https://api.cloudflare.com/client/v4/accounts/<id>/ai/v1
#                   @cf/meta/llama-3.3-70b-instruct-fp8-fast
#   SambaNova       https://api.sambanova.ai/v1
#                   Meta-Llama-3.3-70B-Instruct (20 RPD — low)
#   OpenRouter      https://openrouter.ai/api/v1
#                   nvidia/nemotron-3-super-120b-a12b:free

SESSION_SECRET=
FRONTEND_ORIGIN=http://localhost:5173
